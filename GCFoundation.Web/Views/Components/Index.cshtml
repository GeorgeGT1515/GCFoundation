@using GCFoundation.Web.Models.Components
@using GCFoundation.Web.Resources
@model List<ComponentIndexViewModel>

<gcds-heading tag="h1" margin-bottom="400">@Components.Index_Page_Title</gcds-heading>

<gcds-grid columns="1fr" columns-desktop="repeat(3, 1fr)" columns-tablet="repeat(2, 1fr)" equal-row-height>
@foreach (var component in Model.OrderBy(c => c.Name))
{
    <gcds-card  badge="@(component.IsNew == true ? Components.Card_Badge_New : null)"
                card-title="@component.Name"
                description="@component.ShortDescription"
                href="@component.Href"
                img-alt="@string.Format(Components.Index_Card_ImgAlt_Template, component.Name)"
                img-src="@component.ImgSrc">
        @Html.Raw(component.Description)
    </gcds-card>
}
</gcds-grid>
@using GCFoundation.Components.Models
@using GCFoundation.Components.TagHelpers.GCDS
@using GCFoundation.Web.Resources
@using Microsoft.AspNetCore.Routing

<gcds-heading tag="h1" margin-bottom="400">@Components.Index_Page_Title</gcds-heading>

@{
    var components = new List<CardTagHelper>()
    {
        new CardTagHelper() { CardTitle = Components.Index_Badge_Title, Description = Components.Index_Badge_Description, Href = @Url.Action("Badge", "Components") ?? string.Empty, ImgSrc = Url.Content("~/images/preview-badge.svg") },
        new CardTagHelper() { CardTitle = Components.Index_Card_Title, Description = Components.Index_Card_Description, Href = @Url.Action("Card", "Components") ?? string.Empty, ImgSrc = Url.Content("~/images/preview-card.svg") },
        new CardTagHelper() { CardTitle = Components.Index_FilteredSearch_Title, Description = Components.Index_FilteredSearch_Description, Href = @Url.Action("FilteredSearch", "Components") ?? string.Empty, ImgSrc = Url.Content("~/images/preview-filtered-search.svg") },
        new CardTagHelper() { CardTitle = Components.Index_FormBuilder_Title, Description = Components.Index_FormBuilder_Description, Href = @Url.Action("FormBuilder", "Components") ?? string.Empty, ImgSrc = Url.Content("~/images/preview-form-builder.svg") },
        new CardTagHelper() { CardTitle = Components.Index_Form_Title, Description = Components.Index_Form_Description, Href = @Url.Action("Form", "Components") ?? string.Empty, ImgSrc = Url.Content("~/images/preview-form.svg") },
        new CardTagHelper() { CardTitle = Components.Index_Modal_Title, Description = Components.Index_Modal_Description, Href = @Url.Action("Modal", "Components") ?? string.Empty, ImgSrc = Url.Content("~/images/preview-modal.svg") },
        new CardTagHelper() { CardTitle = Components.Index_PageHeading_Title, Description = Components.Index_PageHeading_Description, Href = @Url.Action("PageHeading", "Components") ?? string.Empty, ImgSrc = Url.Content("~/images/preview-page-heading.svg") },
        new CardTagHelper() { CardTitle = Components.Index_Stepper_Title, Description = Components.Index_Stepper_Description, Href = @Url.Action("Stepper", "Components") ?? string.Empty, ImgSrc = Url.Content("~/images/preview-stepper-fdcp.svg") },
        new CardTagHelper() { CardTitle = Components.Index_Table_Title, Description = Components.Index_Table_Description, Href = @Url.Action("Table", "Components") ?? string.Empty, ImgSrc = Url.Content("~/images/preview-table.svg") },
        new CardTagHelper() { CardTitle = Components.Index_UserLoginPartial_Title, Description = Components.Index_UserLoginPartial_Description, Href = @Url.Action("UserLogin", "Components") ?? string.Empty, ImgSrc = Url.Content("~/images/preview-user-login-partial.svg") }
    };
}

<gcds-grid columns="repeat(3, 1fr)" equal-row-height>
@foreach (var component in components.OrderBy(c => c.CardTitle))
{
    <gcds-card  card-title="@component.CardTitle"
                description="@component.Description"
                href="@component.Href"
                img-alt="@string.Format(Components.Index_Card_ImgAlt_Template, component.CardTitle)"
                img-src="@component.ImgSrc"></gcds-card>
}
</gcds-grid>
@using GCFoundation.Components.Enums
@using GCFoundation.Web.Resources
@model GCFoundation.Web.Models.FormTestViewModel

@* Sample form *@
@{
    var sampleForm = Model.SampleCodeSections.First();
}
<gcds-heading tag="h2" id="@sampleForm.Id">@sampleForm.Title</gcds-heading>
@if (!string.IsNullOrEmpty(sampleForm.Description))
{
    @Html.Raw(sampleForm.Description)
}

@if (Model == null)
{
    <p class="error-text">Model is NULL!</p>
}
else
{
    if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <gcds-notice notice-role="@AlertType.success" notice-title-tag="h3" notice-title="@GCFoundation.Components.Resources.Localization.Validation_Success" class="mb-300">
            <gcds-text>@Model.SuccessMessage</gcds-text>
        </gcds-notice>
    }

    <fdcp-form method="post" action="@Url.Action("Form", "Components")" for="@Model">
        @Html.AntiForgeryToken()
        <fdcp-input for="@Model.FullName" />
        <fdcp-input for="@Model.Email" />
        <fdcp-input for="@Model.Password" />
        <fdcp-input for="@Model.Website" />

        <fdcp-input for="@Model.Age" />
        <fdcp-rich-text for="@Model.Bio"
                        toolbar="Standard"
                        height="240px"
                        placeholder="@Components.Form_Bio_Placeholder" />
        <fdcp-input for="@Model.DateOfBirth" />

        <fdcp-select for="@Model.SelectedCountry" items="@Model.CountryOptions" />

        <fdcp-radios for="@Model.Gender" items="@Model.GenderOptions" />

        <fdcp-checkboxes for="@Model.SelectedInterests" items="@Model.InterestOptions" />

        <fdcp-checkbox for="@Model.AgreeToTerms" />

        <gcds-button type="submit">Submit</gcds-button>
        <gcds-button type="reset" button-role="secondary">Reset</gcds-button>
    </fdcp-form>

<pre><code class="language-cshtml">@Html.Raw(Html.Encode(@"
<fdcp-form method=""post"" action=""@Url.Action(""Form"", ""Components"")"" for=""@Model"">
        <fdcp-input for=""@Model.FullName"" />
        <fdcp-input for=""@Model.Email"" />
        <fdcp-input for=""@Model.Password"" />
        <fdcp-input for=""@Model.Website"" />
        <fdcp-input for=""@Model.Age"" />
        <fdcp-rich-text for=""@Model.Bio""
                        toolbar=""Standard""
                        height=""240px""
                        placeholder=""@Components.Form_Bio_Placeholder"" />
        <fdcp-input for=""@Model.DateOfBirth"" />

        <fdcp-select for=""@Model.SelectedCountry"" items=""@Model.CountryOptions"" />

        <fdcp-radios for=""@Model.Gender"" items=""@Model.GenderOptions"" />

        <fdcp-checkboxes for=""@Model.SelectedInterests"" items=""@Model.InterestOptions"" />

        <fdcp-checkbox for=""@Model.AgreeToTerms"" />

        <gcds-button type=""submit"">Submit</gcds-button>
        <gcds-button type=""reset"" button-role=""secondary"">Reset</gcds-button>
</fdcp-form>"))</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Components.Shared_CopyButton_SuccessText">@Components.Shared_CopyButton_Text</gcds-button></pre>
}
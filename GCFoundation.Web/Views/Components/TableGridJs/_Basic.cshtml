@using GCFoundation.Components.Enums
@using GCFoundation.Components.Models.TableGridJs
@using GCFoundation.Web.Resources
@using System.Globalization

@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var currentLang = currentCulture == "fr" ? Language.fr : Language.en;

    var columns = new[]
    {
        new TableGridJsColumn { Id = "id", Name = "ID", Sortable = true, Width = "99px" },
        new TableGridJsColumn { Id = "name", Name = currentLang == Language.fr ? "Nom" : "Name", Sortable = true },
        new TableGridJsColumn { Id = "department", Name = currentLang == Language.fr ? "Département" : "Department", Sortable = true }
    };
    
    var caption = currentLang == Language.fr ? "Employés" : "Employees";
    var summary = currentLang == Language.fr
        ? "Tableau triable, recherchable et paginé des employés" 
        : "Sortable, searchable and paginated table of employees";
    var ariaLabel = currentLang == Language.fr ? "Tableau des employés" : "Employees table";
}

<h3>@Components.TableGridJs_Basic_Title</h3>
<gcds-text>@Html.Raw(Components.TableGridJs_Basic_Text)</gcds-text>

<div class="fdcp-table-responsive">
    <fdcp-table-gridjs  id="employees-grid"
                        ajax-url="@Url.Content("~/api/grid/employees")"
                        caption="@caption"
                        summary="@summary"
                        page-size="10"
                        aria-label="@ariaLabel"
                        lang="@currentLang"
                        columns="@columns"
                        class="fdcp-table-bordered fdcp-table-condensed fdcp-table-hover fdcp-table-striped">
    </fdcp-table-gridjs>
</div>


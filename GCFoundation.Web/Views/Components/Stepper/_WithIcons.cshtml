@using GCFoundation.Components.Models

<fdcp-stepper current-step="2"
              steps="@(new List<StepperStep>
                                {
                                    new StepperStep { StepNumber = 1, Label = "Complete", DisplayMode = StepDisplayMode.Icon, CompletedIconHtml = "<i class='fa fa-check'></i>" },
                                    new StepperStep { StepNumber = 2, Label = "In Progress", DisplayMode = StepDisplayMode.Icon, InProgressIconHtml = "<i class='fa fa-spinner spinning-image'></i>" },
                                    new StepperStep { StepNumber = 3, Label = "Not Started", DisplayMode = StepDisplayMode.Icon }
                                })"></fdcp-stepper>

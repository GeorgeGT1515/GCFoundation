@using GCFoundation.Components.Enums
@using GCFoundation.Components.Models

<fdcp-stepper current-step="2"
              steps="@(new List<StepperStep>
                                {
                                    new StepperStep { StepNumber = 1, Label = "Step 1", DisplayMode = StepperStepDisplayMode.Icon, StatusBadgeLabel = "Done", StatusBadgeStyle = BadgeStyle.info, StatusBadgeStyleInverted = true, CompletedIconHtml = "<i class='fa fa-check'></i>" },
                                    new StepperStep { StepNumber = 2, Label = "Step 2", DisplayMode = StepperStepDisplayMode.Icon, StatusBadgeLabel = "Not required", StatusBadgeStyle = BadgeStyle.info, StatusBadgeStyleInverted = false, CompletedIconHtml = "<i class='fa-solid fa-xmark'></i>" },
                                    new StepperStep { StepNumber = 2, Label = "Step 3", DisplayMode = StepperStepDisplayMode.Icon, InProgressIconHtml = "<i class='fa fa-spinner'></i>" },
                                    new StepperStep { StepNumber = 3, Label = "Step 4", DisplayMode = StepperStepDisplayMode.Icon }
                                })"></fdcp-stepper>

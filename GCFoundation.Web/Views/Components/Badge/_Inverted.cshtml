@using GCFoundation.Web.Resources
@using GCFoundation.Components.Enums
@using GCFoundation.Components.TagHelpers.FDCP
@model GCFoundation.Web.Models.Components.ComponentSampleCodeSectionViewModel

@foreach (BadgeStyle style in Enum.GetValues(typeof(BadgeStyle)))
{
    <fdcp-badge style="@style" inverted="true">@style.ToString()</fdcp-badge>
}
<pre><code class="language-html">&lt;fdcp-badge style="primary" inverted="true"&gt;Primary&lt;/fdcp-badge&gt;</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Components.Shared_CopyButton_SuccessText">@Components.Shared_CopyButton_Text</gcds-button></pre>
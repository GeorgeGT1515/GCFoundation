<fdcp-card>
    <gcds-grid tag="article" align-items="center"
               columns-desktop="1fr 2fr 12fr 3fr" columns-tablet="1fr 2fr 12fr 3fr" columns="1fr">
        <div class="d-grid md:justify-items-center justify-items-start">
            <fdcp-checkbox name="select"></fdcp-checkbox>
        </div>
        <div class="d-grid md:justify-items-center justify-items-start">
            <p class="font-size-h3 mb-0">95%</p>
            <p class="font-text-small mb-0">match</p>
        </div>
        <div class="d-grid justify-items-start">
            <p class="font-text font-bold mb-0">Senior Policy Analyst, Indigenous Reconciliation</p>
            <p class="font-text-small font-light mb-0">ISJD · JOB-10499 · Insert · Insert</p>
            <p class="font-text-small mb-0">...development and consultation activities with First Nations, Inuit, etc. Leads policy and Métis partners. Reports to the Director General, Strategic Policy</p>
        </div>
        <div class="d-grid md:justify-items-end justify-items-start">
            <gcds-button button-role="secondary">View</gcds-button>
        </div>
    </gcds-grid>
</fdcp-card>


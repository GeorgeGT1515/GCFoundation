@using GCFoundation.Web.Models.Table

@{
    var rows = new List<TableRowLinkTestViewModel>
    {
        new() { SubmissionId = "001", SubmitterName = "Alice Tremblay",  DateSubmitted = new DateTime(2025, 3, 10,  9,  0, 0), AssignedReviewer = "Bob Martin",     Link = "View submission" },
        new() { SubmissionId = "002", SubmitterName = "Jean Dupont",     DateSubmitted = new DateTime(2025, 3, 11, 14, 30, 0), AssignedReviewer = "Alice Tremblay", Link = "View submission" },
        new() { SubmissionId = "003", SubmitterName = "Sarah Lee",       DateSubmitted = new DateTime(2025, 3, 12, 10, 15, 0), AssignedReviewer = "Bob Martin",     Link = "View submission" },
    };
}

<fdcp-table caption="Table with link" rows="@rows">
    <template slot="cell:link">
        <gcds-link data-bind="link" data-bind-template-href="/table/{submitterName}"></gcds-link>
    </template>
</fdcp-table>

<pre><code class="language-cshtml">@Html.Raw(Html.Encode(@"<fdcp-table caption=""My table"" rows=""@Model.Rows"">
    <template slot=""cell:link"">
        <gcds-link data-bind=""link"" data-bind-template-href=""/table/{submitterName}""></gcds-link>
    </template>
</fdcp-table>"))</code></pre>

<pre><code class="language-csharp">@Html.Raw(Html.Encode(@"[Display(Name = ""Link_Header"", ResourceType = typeof(Resources.Components))]
[TableColumnDefinition(Slotted = true)]
public string Link { get; set; }
"))</code></pre>
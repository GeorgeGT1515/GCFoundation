@using GCFoundation.Components.TagHelpers.FDCP
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var economicsGroup = new SelectListGroup { Name = "Economics and Social Science Services (EC)" };
    var policyGroup = new SelectListGroup { Name = "Program Administration (PM)" };
    var classificationOptions = new List<SelectListItem>
    {
        new() { Value = "EC-02", Text = "EC-02", Group = economicsGroup },
        new() { Value = "EC-03", Text = "EC-03", Group = economicsGroup },
        new() { Value = "EC-04", Text = "EC-04", Group = economicsGroup },
        new() { Value = "EC-05", Text = "EC-05", Group = economicsGroup },
        new() { Value = "EC-06", Text = "EC-06", Group = economicsGroup },
        new() { Value = "PM-03", Text = "PM-03", Group = policyGroup },
        new() { Value = "PM-04", Text = "PM-04", Group = policyGroup }
    };
}

<fdcp-searchable-dropdown items="@classificationOptions"
                          name="classificationLevels"
                          label="Classification group & level"
                          default-value="Select option"
                          search-placeholder="Search"
                          selection-mode="@FDCPSearchableDropdownSelectionMode.Multiple">
    <div slot="selected-options">
        <span><strong data-fdcp-searchable-dropdown-selected-count>0</strong> option(s) selected</span>
        <gcds-button type="button" button-role="secondary" data-fdcp-searchable-dropdown-clear>Clear</gcds-button>
    </div>
</fdcp-searchable-dropdown>


@using Microsoft.AspNetCore.Mvc.Rendering
@using GCFoundation.Web.Resources

@{
    var countryOptions = new List<SelectListItem>
    {
        new() { Value = "CA", Text = Components.SearchableDropdown_Sample_Country_CA },
        new() { Value = "US", Text = Components.SearchableDropdown_Sample_Country_US },
        new() { Value = "MX", Text = Components.SearchableDropdown_Sample_Country_MX },
        new() { Value = "FR", Text = Components.SearchableDropdown_Sample_Country_FR },
        new() { Value = "SV", Text = Components.SearchableDropdown_Sample_Country_SV }
    };
}

<div class="searchable-dropdown-basic-example">
    <fdcp-searchable-dropdown items="@countryOptions"
                              name="country"
                              label="@Components.SearchableDropdown_Sample_Country_Label"
                              hint="@Components.SearchableDropdown_Sample_Country_Hint"
                              default-value="@Components.SearchableDropdown_Sample_Country_DefaultValue"
                              search-placeholder="@Components.SearchableDropdown_Sample_Country_SearchPlaceholder"
                              no-results-text="@Components.SearchableDropdown_Sample_Country_NoResultsText"></fdcp-searchable-dropdown>
</div>


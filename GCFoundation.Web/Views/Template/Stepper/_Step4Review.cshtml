@using GCFoundation.Web.Resources
@model GCFoundation.Web.Models.Template.TemplateStepperFormViewModel

@{
    var notProvided = Template.Stepper_Demo_Review_NotProvided;
    string OrNotProvided(string? value) => string.IsNullOrWhiteSpace(value) ? notProvided : value;

    var contact = OrNotProvided(Model.ContactOptions is null ? null : string.Join(", ", Model.ContactOptions));
    var dob = OrNotProvided(Model.DateOfBirth?.ToString("d"));
    var country = OrNotProvided(Model.CountryOptions.FirstOrDefault(c => c.Value == Model.SelectedCountry)?.Text ?? Model.SelectedCountry);
    var province = OrNotProvided(Model.ProvinceList.FirstOrDefault(p => p.Value == Model.Province)?.Text ?? Model.Province);
}

<gcds-text>@Template.Stepper_Demo_Review_Intro</gcds-text>

<dl class="fdcp-stepper-review">
    <dt>@Template.Stepper_Demo_FirstName_Label</dt>
    <dd>@OrNotProvided(Model.FirstName)</dd>

    <dt>@Template.Stepper_Demo_LastName_Label</dt>
    <dd>@OrNotProvided(Model.LastName)</dd>

    <dt>@Template.Stepper_Demo_Province_Label</dt>
    <dd>@province</dd>

    <dt>@Template.Stepper_Demo_ContactOptions_Label</dt>
    <dd>@contact</dd>

    <dt>@Components.Form_Bio_Label</dt>
    <dd>@(string.IsNullOrWhiteSpace(Model.Bio) ? notProvided : Html.Raw(Model.Bio))</dd>

    <dt>@Components.Form_DateOfBirth_Label</dt>
    <dd>@dob</dd>

    <dt>@Components.Form_Country_Label</dt>
    <dd>@country</dd>

    <dt>@Components.Form_Gender_Label</dt>
    <dd>@OrNotProvided(Model.Gender)</dd>

    <dt>@Components.Form_Website_Label</dt>
    <dd>@OrNotProvided(Model.Website)</dd>

    <dt>@Components.Form_Age_Label</dt>
    <dd>@OrNotProvided(Model.Age?.ToString())</dd>
</dl>

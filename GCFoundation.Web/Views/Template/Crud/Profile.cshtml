@using System.Reflection
@using System.ComponentModel.DataAnnotations;
@using GCFoundation.Web.Models.Template.Crud;
@model EmployeeViewModel;
@{
    var properties = Model.GetType()
    .GetProperties()
    .Where(p => p.GetCustomAttribute<DisplayAttribute>() != null);
}

<gcds-heading tag="h1">Employee Profile</gcds-heading>
<gcds-heading tag="h2">@Model.Name</gcds-heading>
@foreach(var prop in properties)
{
    var display = prop.GetCustomAttribute<DisplayAttribute>()!.GetName();
    var value = prop.GetValue(Model);
    if (prop.Name != "Name")
    {
        <gcds-text><strong>@display: </strong>@value</gcds-text>
    }
}

<section class="mt-400">
    <gcds-button button-role="secondary" type="link" href="@Url.Action("CrudDemo", "Template")"><gcds-icon name="chevron-left" margin-right="50"></gcds-icon>Back</gcds-button>
</section>


@model GCFoundation.Web.Models.Template.Crud.DemoViewModel;

<gcds-heading tag="h1">Crud demo page</gcds-heading>

<section class="mt-400">
    <gcds-button button-role="primary" type="link" href="@Url.Action("CrudEdit", "Template")">Add employee</gcds-button>
</section>

<fdcp-table filter sort pagination-size="10" caption="Employee List" rows="@Model.EmployeeModels">
    <template slot="cell:actions">
        <div class="fdcp-bind-group">
            <gcds-button data-bind-template-button-id="delete-button-{id}" data-bind-data-employee-id="id" data-bind-data-employee-name="name" modal-id="delete-employee-modal" title="Delete employee" button-role="danger" class="fdcp-modal-open" size="small">Delete</gcds-button>
            <gcds-button data-bind-template-button-id="view-button-{id}" title="View profile" button-role="primary" type="link" data-bind-template-href="/template/crud/profile/{id}" size="small">View</gcds-button>
            <gcds-button data-bind-template-button-id="edit-button-{id}" title="Edit Profile" button-role="secondary" type="link" data-bind-template-href="/template/crud/edit/{id}" size="small">Edit</gcds-button>
        </div>  
    </template>
</fdcp-table>


<fdcp-modal title="Are you sure you want to delete this user?" modal-id="delete-employee-modal" state="warning">
        <div slot="body">
            <gcds-text>You will delete employee <strong data-employee-name-display></strong>. <br>Click confirm to proceed.</gcds-text>
        </div>
        <div slot="footer">
            <fdcp-form for="@Model" method="post" action="@Url.Action("CrudDelete", "Template")">
                <gcds-button button-id="delete-employee" type="submit" name="id" value="" button-role="danger">Confirm</gcds-button>
                <gcds-button button-id="delete-employee-cancel" button-role="secondary" class="fdcp-modal-close">Back</gcds-button>
            </fdcp-form>
        </div>
</fdcp-modal>
<section class="mt-400">
    <gcds-button button-role="primary" type="link" href="@Url.Action("CrudEdit", "Template")">Add employee</gcds-button>
</section>

<gcds-table filter sort columns="" data="" class="mt-400" >
    <div slot="caption">
        <h5>Employee List</h5>
        <gcds-button class="mb-100" size="small">Add employee</gcds-button>
    </div>
</gcds-table>
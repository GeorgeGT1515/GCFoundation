@using GCFoundation.Web.Resources

<gcds-heading tag="h1">@Template.Crud_Code_Name</gcds-heading>
@Html.Raw(Template.Crud_Code_Intro)

<gcds-heading tag="h2">@Template.Crud_Code_Demo_Title</gcds-heading>
<pre><code class="language-cshtml">@Html.Raw(Html.Encode(@"@model GCFoundation.Web.Models.Template.Crud.DemoViewModel
@using GCFoundation.Components.Resources
@using GCFoundation.Web.Resources

<gcds-heading tag=""h1"">@Template.Crud_Demo_PageTitle</gcds-heading>
<gcds-container size=""lg"">
    <fdcp-table filter sort pagination-size=""10""
                caption=""@Template.Crud_Demo_TableCaption""
                caption-detail=""@Template.Crud_Demo_TableCaptionDetail""
                rows=""@Model.EmployeeModels"">
        <template slot=""cell:actions"">
            <div class=""fdcp-bind-group"">
                <gcds-button data-bind-template-button-id=""view-button-{id}"" title=""@Template.Crud_Demo_ViewProfile_Title"" button-role=""primary"" type=""link"" data-bind-template-href=""profile/{id}"" size=""small"">@Localization.View</gcds-button>
                <gcds-button data-bind-template-button-id=""edit-button-{id}"" title=""@Template.Crud_Demo_EditProfile_Title"" button-role=""secondary"" type=""link"" data-bind-template-href=""edit/{id}"" size=""small"">@Localization.Edit</gcds-button>
                <gcds-button data-bind-template-button-id=""delete-button-{id}"" data-bind-data-employee-id=""id"" data-bind-data-employee-name=""name"" modal-id=""delete-employee-modal"" title=""@Template.Crud_Demo_DeleteEmployee_Title"" button-role=""danger"" class=""fdcp-modal-open"" size=""small"">@Localization.Delete</gcds-button>
            </div>
        </template>
    </fdcp-table>
</gcds-container>

<fdcp-modal title=""@Template.Crud_Demo_DeleteModal_Title""
            modal-id=""delete-employee-modal""
            state=""warning"">
    <div slot=""body"">
        <gcds-text>
            @Template.Crud_Demo_DeleteModal_Text
            <strong data-employee-name-display></strong>.
            @Template.Crud_Demo_DeleteModal_Instruction
        </gcds-text>
    </div>
    <div slot=""footer"">
        <fdcp-form for=""@Model"" method=""post"" action=""@Url.Action(""CrudDelete"", ""Template"")"">
            @Html.AntiForgeryToken()
            <gcds-button button-id=""delete-employee"" type=""submit"" name=""id"" value="""" button-role=""danger"">@Localization.Delete</gcds-button>
            <gcds-button button-id=""delete-employee-cancel"" button-role=""secondary"" class=""fdcp-modal-close"">@Localization.Cancel</gcds-button>
        </fdcp-form>
    </div>
</fdcp-modal>

<section class=""mt-400"">
    <gcds-button button-role=""primary"" type=""link"" href=""@Url.Action(""CrudEdit"", ""Template"")"">@Template.Crud_Demo_AddEmployee_Button</gcds-button>
</section>"))</code></pre>

<gcds-heading tag="h2">@Template.Crud_Code_Edit_Title</gcds-heading>
<gcds-text>@Template.Crud_Code_Edit_Text</gcds-text>
<pre><code class="language-cshtml">@Html.Raw(Html.Encode(@"@model GCFoundation.Web.Models.Template.Crud.EmployeeViewModel
@using GCFoundation.Components.Resources
@using GCFoundation.Web.Resources
@{
    var managerList = new List<SelectListItem>();
    var departmentList = new List<SelectListItem>();
}

<gcds-heading tag=""h1"">@Template.Crud_Edit_PageTitle</gcds-heading>

<fdcp-form method=""post"" for=""@Model"" action=""@Url.Action(""CrudSave"", ""Template"")"">
    @Html.AntiForgeryToken()
    <fdcp-input for=""@Model.Name""></fdcp-input>
    <fdcp-input for=""@Model.Id""></fdcp-input>
    <fdcp-input for=""@Model.Level""></fdcp-input>
    <fdcp-searchable-select for=""@Model.Department"" items=""@departmentList""></fdcp-searchable-select>
    <fdcp-searchable-select for=""@Model.ManagerName"" items=""@managerList""></fdcp-searchable-select>
    <fdcp-input for=""@Model.Salary""></fdcp-input>
    <fdcp-input for=""@Model.Address""></fdcp-input>

    <section class=""mt-400"">
        <gcds-button class=""fdcp-modal-open"" modal-id=""save-profile-modal"">@Localization.Save</gcds-button>
        <gcds-button class=""fdcp-modal-open"" button-role=""danger"" modal-id=""reset-profile-modal"">@Localization.Reset</gcds-button>
    </section>

    <fdcp-modal title=""@Template.Crud_Edit_SaveModal_Title"" modal-id=""save-profile-modal"">
        <div slot=""body"">
            <gcds-text>@Template.Crud_Edit_SaveModal_Text</gcds-text>
        </div>
        <div slot=""footer"">
            <gcds-button button-id=""save-profile"" type=""submit"">@Template.Crud_Edit_Confirm_Button</gcds-button>
            <gcds-button button-id=""save-profile-cancel"" button-role=""secondary"" class=""fdcp-modal-close"">@Localization.Cancel</gcds-button>
        </div>
    </fdcp-modal>

    <fdcp-modal title=""@Template.Crud_Edit_ResetModal_Title""
                modal-id=""reset-profile-modal""
                state=""warning"">
        <div slot=""body"">
            <gcds-text>@Template.Crud_Edit_ResetModal_Text</gcds-text>
        </div>
        <div slot=""footer"">
            <gcds-button button-id=""reset-profile"" type=""reset"" button-role=""danger"" class=""fdcp-modal-close"">@Template.Crud_Edit_Confirm_Button</gcds-button>
            <gcds-button button-id=""reset-profile-cancel"" button-role=""secondary"" class=""fdcp-modal-close"">@Localization.Cancel</gcds-button>
        </div>
    </fdcp-modal>
</fdcp-form>

<section class=""mt-400"">
    <gcds-button type=""link"" button-role=""secondary"" href=""@Url.Action(""CrudDemo"", ""Template"")""><gcds-icon name=""chevron-left"" margin-right=""50""></gcds-icon>@Template.Crud_BackToEmployeeList_Button</gcds-button>
</section>"))</code></pre>

<gcds-heading tag="h2">@Template.Crud_Code_EmployeeViewModel_Title</gcds-heading>
<gcds-text>@Template.Crud_Code_EmployeeViewModel_Text</gcds-text>
<pre><code class="language-csharp">@Html.Raw(Html.Encode(@"using GCFoundation.Common.Utilities;
using GCFoundation.Components.Attributes;
using GCFoundation.Components.Attributes.Table;
using GCFoundation.Components.Models;
using System.ComponentModel.DataAnnotations;

namespace GCFoundation.Web.Models.Template.Crud
{
    public class EmployeeViewModel : BaseViewModel
    {
        [TableColumnDefinition(Slotted = true, Order = 4)]
        public string Actions { get; set; } = string.Empty;

        [Display(Name = ""Crud_Demo_Address_Label"", ResourceType = typeof(Resources.Template), Order = 9)]
        public string Address { get; set; } = string.Empty;

        [DataType(DataType.Date)]
        [DateFormat(""yyyy-mm-dd"")]
        [Display(Name = ""Crud_Demo_DateOfBirth_Label"", ResourceType = typeof(Resources.Template), Order = 8)]
        public DateTime DateOfBirth { get; set; } = DateTime.Now;

        [Display(Name = ""Crud_Demo_Department_Label"", ResourceType = typeof(Resources.Template), Order = 5)]
        public string Department => LanguageUtility.IsFrench() ? DepartmentFr : DepartmentEn;

        public string DepartmentEn { get; set; } = string.Empty;
        public string DepartmentFr { get; set; } = string.Empty;

        [Display(Name = ""Crud_Demo_EmployeeId_Label"", ResourceType = typeof(Resources.Template), Order = 2)]
        [TableColumnDefinition(RowHeader = true, Sort = true, Order = 1)]
        public string Id { get; set; } = string.Empty;

        [Display(Name = ""Crud_Demo_EmployeeLevel_Label"", ResourceType = typeof(Resources.Template), Order = 3)]
        [TableColumnDefinition(Sort = true, Order = 3)]
        public string Level { get; set; } = string.Empty;

        [Display(Name = ""Crud_Demo_ManagerName_Label"", ResourceType = typeof(Resources.Template), Order = 6)]
        public string ManagerName { get; set; } = string.Empty;

        [Display(Name = ""Crud_Demo_EmployeeName_Label"", ResourceType = typeof(Resources.Template), Order = 2)]
        [TableColumnDefinition(Sort = true, Order = 2)]
        public string Name { get; set; } = string.Empty;

        [Display(Name = ""Crud_Demo_Salary_Label"", ResourceType = typeof(Resources.Template), Order = 4)]
        public double Salary { get; set; }

        [DataType(DataType.Date)]
        [DateFormat(""yyyy-mm-dd"")]
        [Display(Name = ""Crud_Demo_StartDate_Label"", ResourceType = typeof(Resources.Template), Order = 7)]
        public DateTime StartDate { get; set; } = DateTime.Now;
    }
}"))</code></pre>

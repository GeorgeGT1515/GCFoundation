@using GCFoundation.Components.Resources
@using GCFoundation.Web.Resources

<gcds-heading tag="h1">@Template.LanguageChooser_Name</gcds-heading>

<gcds-notice class="fdcp-mb-200" type="Warning" title="Work in progress..." title-tag="h2">This page is under development.</gcds-notice>

<div class="documentation-content">
    @* Introduction *@
    <gcds-text>@Html.Raw(Template.LanguageChooser_Intro)</gcds-text>

    @* When to Use *@
    <gcds-heading tag="h2" id="@Template.WhenToUse_Anchor">@Template.WhenToUse</gcds-heading>
    @Html.Raw(string.Format(Template.LanguageChooser_WhenToUse, Url.Action("Index", "Components")))

    @* Preview *@
    <gcds-heading tag="h2" id="@Template.Preview_Anchor">@Template.Preview</gcds-heading>
    <p>
        <gcds-button button-role="secondary" type="link" href="@Url.Action("LanguageChooserDemo", "Template")" target="_blank">@Template.Demo_Button <i class="fdcp-ms-100 fa-solid fa-desktop"></i></gcds-button>
        <gcds-button button-role="secondary" type="link" href="@Url.Action("LanguageChooserCode", "Template")">@Template.Code_Button <i class="fdcp-ms-100 fa-solid fa-code"></i></gcds-button>
    </p>
    @* Preview image *@
    @* <img src="@Url.Content($"~/images/templates/basic-demo-{Localization.ThreeLetterLanguage}.png")" alt="@Template.Basic_Demo_Image_AltText" class="fdcp-border fdcp-rounded fdcp-w-75" /> *@

    @* How to implement *@
    <gcds-heading tag="h2" id="@Template.HowToImplement_Anchor">@Template.HowToImplement</gcds-heading>
    @Html.Raw(string.Format(Template.LanguageChooser_HowToImplement, Url.Action("Index", "Installation")))

    @* Notes/Highlights *@
    <gcds-heading tag="h2" id="@Template.Notes_Anchor">@Template.Notes</gcds-heading>
    @Html.Raw(Template.LanguageChooser_Notes)
</div>
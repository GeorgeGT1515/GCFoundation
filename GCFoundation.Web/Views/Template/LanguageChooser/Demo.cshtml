@using GCFoundation.Components.Models
@using GCFoundation.Web.Resources
@model LanguageChooserModel
@{
    ViewData["Title"] = Template.LanguageChooser_Demo_Name;
    var nonce = Context.Items["CspNonce"] as string;
}

<style nonce="@nonce">
    .lc-demo-box { max-width: 500px; margin: 0 auto; }
    .lc-demo-header { padding: 30px 30px 19px; background-color: #f8f8f8; }
    .lc-demo-footer { background-color: #e1e4e7; padding: 30px 30px 13px; }
    .lc-demo-logo { width: 283px; }
    .lc-demo-asterisk { color: #9e9e9e; font-size: 6px; }
</style>

<gcds-heading tag="h1">@Template.LanguageChooser_Demo_Name</gcds-heading>

<div id="choosing-box" class="lc-demo-box">
    <div class="lc-demo-header">
        <h1 translate="no" class="sr-only">@Model?.ApplicationTitleEn / @Model?.ApplicationTitleFr</h1>
        <div class="lc-demo-logo">
            <gcds-signature></gcds-signature>
        </div>
        <gcds-grid columns="1fr 1fr" equal-row-height="true">
            <section class="text-right pt-300" lang="en">
                <h2 class="sr-only">@Model?.ApplicationTitleEn</h2>
                <p>
                    <gcds-button type="link" href="@Model?.EnglishAction" translate="no">English</gcds-button>
                </p>
            </section>
            <section class="text-left pt-300" lang="fr">
                <h2 class="sr-only">@Model?.ApplicationTitleFr</h2>
                <p>
                    <gcds-button type="link" href="@Model?.FrenchAction" translate="no">Français</gcds-button>
                </p>
            </section>
        </gcds-grid>
    </div>
    <div class="lc-demo-footer">
        <gcds-grid columns="2fr 1fr" equal-row-height="true">
            <div>
                @if (!string.IsNullOrWhiteSpace(Model?.TermLinkEn) || !string.IsNullOrWhiteSpace(Model?.TermLinkFr))
                {
                    <a href="@Model?.TermLinkEn">Terms &amp; conditions</a>
                    <span class="fa-solid fa-asterisk lc-demo-asterisk"></span>
                    <a href="@Model?.TermLinkFr">Avis</a>
                }
            </div>
            <div><gcds-signature type="Wordmark"></gcds-signature></div>
        </gcds-grid>
    </div>
</div>


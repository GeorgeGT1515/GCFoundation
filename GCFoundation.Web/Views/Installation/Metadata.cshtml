@using GCFoundation.Web.Resources
@using System.Web

<gcds-heading tag="h1">@Installation.Metadata_Page_Title</gcds-heading>
<gcds-text>@Html.Raw(Installation.Metadata_Description)</gcds-text>

<gcds-grid columns="minmax(200px, 300px) minmax(0, 1fr)">
	<gcds-side-nav label="@Installation.Metadata_SideNav_OnThisPage">
		<gcds-nav-link href="#overview">@Installation.Metadata_Nav_Overview</gcds-nav-link>
		<gcds-nav-link href="#how-it-works">@Installation.Metadata_Nav_HowItWorks</gcds-nav-link>
		<gcds-nav-link href="#usage">@Installation.Metadata_Nav_Usage</gcds-nav-link>
		<gcds-nav-link href="#layout-merge">@Installation.Metadata_Nav_LayoutMerge</gcds-nav-link>
		<gcds-nav-link href="#configuration">@Installation.Metadata_Nav_Configuration</gcds-nav-link>
		<gcds-nav-link href="#behavior">@Installation.Metadata_Nav_Behavior</gcds-nav-link>
		<gcds-nav-link href="#examples">@Installation.Metadata_Nav_Examples</gcds-nav-link>
		<gcds-nav-link href="#notes">@Installation.Metadata_Nav_Notes</gcds-nav-link>
	</gcds-side-nav>

	<div class="documentation-content">
		<gcds-heading tag="h2" id="overview">@Installation.Metadata_Heading_Overview</gcds-heading>
		<ul>
			<li>@Html.Raw(Installation.Metadata_Overview_Item_BaseController)</li>
			<li>@Html.Raw(Installation.Metadata_Overview_Item_TypedModel)</li>
			<li>@Html.Raw(Installation.Metadata_Overview_Item_LayoutMerge)</li>
			<li>@Html.Raw(Installation.Metadata_Overview_Item_Configuration)</li>
		</ul>

		<hr />

		<gcds-heading tag="h2" id="how-it-works">@Installation.Metadata_Heading_HowItWorks</gcds-heading>
		<p>@Installation.Metadata_HowItWorks_Paragraph</p>
		<pre><code class="language-csharp">// Add or replace a meta tag
protected void AddMetaTag(MetaTag tag)
{
	if (tag != null)
	{
		if (!string.IsNullOrEmpty(tag.Name) &amp;&amp; MetaTags.Any(t =&gt; t.Name == tag.Name))
			MetaTags.Remove(MetaTags.First(t =&gt; t.Name == tag.Name));
		if (!string.IsNullOrEmpty(tag.Property) &amp;&amp; MetaTags.Any(t =&gt; t.Property == tag.Property))
			MetaTags.Remove(MetaTags.First(t =&gt; t.Property == tag.Property));
		MetaTags.Add(tag);
	}
}

// After action, expose to the view
public override void OnActionExecuted(ActionExecutedContext context)
{
	ViewData["MetaTags"] = MetaTags;
	base.OnActionExecuted(context);
}</code></pre>

		<hr />

		<gcds-heading tag="h2" id="usage">@Installation.Metadata_Heading_Usage</gcds-heading>
		<p>@Installation.Metadata_Usage_Paragraph</p>
		<pre><code class="language-csharp">using GCFoundation.Common.Models;
using GCFoundation.Components.Controllers;

public class ArticlesController : GCFoundationBaseController
{
	public ArticlesController(ILogger&lt;ArticlesController&gt; logger) : base(logger) { }

	public IActionResult Details(int id)
	{
		AddMetaTag(new MetaTag { Name = "description", Content = "Deep dive into meta tags" });
		AddMetaTag(new MetaTag { Property = "og:title", Content = "Meta Tags 101" });
		AddMetaTag(new MetaTag { Property = "og:type", Content = "article" });
		return View();
	}
}</code></pre>

		<hr />

		<gcds-heading tag="h2" id="layout-merge">@Installation.Metadata_Heading_LayoutMerge</gcds-heading>
		<p>@Installation.Metadata_LayoutMerge_Paragraph</p>
		<div class="language-csharp">
			<pre><code>@@{
	var globalMetaTags = settings.Value.GlobalMetaTags;
	var controllerMetaTags = ViewData["MetaTags"] as IEnumerable&lt;MetaTag&gt;;
	var metaTags = new List&lt;MetaTag&gt;();
	if (controllerMetaTags != null &amp;&amp; controllerMetaTags.Any())
	{
		metaTags.AddRange(controllerMetaTags);
	}
	if (globalMetaTags != null &amp;&amp; globalMetaTags.Any())
	{
		metaTags.AddRange(globalMetaTags.Where(gmt =&gt; !metaTags.Any(mt =&gt; (!string.IsNullOrEmpty(gmt.Name) &amp;&amp; mt.Name == gmt.Name) || (!string.IsNullOrEmpty(gmt.Property) &amp;&amp; mt.Property == gmt.Property))).ToList());
	}
	foreach (var tag in metaTags)
	{
		@@Html.Raw(tag.Render());
	}
}</code></pre>
		</div>

		<hr />

		<gcds-heading tag="h2" id="configuration">@Installation.Metadata_Heading_Configuration</gcds-heading>
		<p>@Installation.Metadata_Configuration_Paragraph</p>
		<pre><code class="language-json">{
	"FoundationComponentsSettings": {
		"GlobalMetaTags": [
			{ "name": "description", "content": "GCFoundation - A comprehensive foundation for building Government of Canada applications" },
			{ "name": "robots", "content": "index, follow" },
			{ "property": "og:title", "content": "GCFoundation" },
			{ "property": "og:type", "content": "website" }
		]
	}
}</code></pre>

		<hr />

		<gcds-heading tag="h2" id="behavior">@Installation.Metadata_Heading_Behavior</gcds-heading>
		<ul>
			<li>@Html.Raw(Installation.Metadata_Behavior_Item_Dedup)</li>
			<li>@Html.Raw(Installation.Metadata_Behavior_Item_Encoding)</li>
			<li>@Html.Raw(Installation.Metadata_Behavior_Item_Attributes)</li>
			<li>@Html.Raw(Installation.Metadata_Behavior_Item_Order)</li>
			<li>@Html.Raw(Installation.Metadata_Behavior_Item_NoViewChanges)</li>
		</ul>

		<hr />

		<gcds-heading tag="h2" id="examples">@Installation.Metadata_Heading_Examples</gcds-heading>
		<pre><code class="language-csharp">// Open Graph + description
AddMetaTag(new MetaTag { Property = "og:title", Content = "Welcome" });
AddMetaTag(new MetaTag { Name = "description", Content = "Page description here" });

// http-equiv and charset
AddMetaTag(new MetaTag { HttpEquiv = "refresh", Content = "30" });
AddMetaTag(new MetaTag { Charset = "UTF-8" });</code></pre>

		<hr />

		<gcds-heading tag="h2" id="notes">@Installation.Metadata_Heading_Notes</gcds-heading>
		<ul>
			<li>@Html.Raw(Installation.Metadata_Notes_Item_BaseClass)</li>
			<li>@Html.Raw(Installation.Metadata_Notes_Item_OptionalSection)</li>
		</ul>
	</div>
</gcds-grid>
    <div class="documentation-content">
        <gcds-heading tag="h2" id="prerequisites">Prerequisites</gcds-heading>
        <ul>
            <li>ASP.NET Core 8.0 or later</li>
            <li>Visual Studio 2022 or later</li>
        </ul>

        <hr />

        <gcds-heading tag="h2" id="nuget-configuration">NuGet Configuration</gcds-heading>
        <p>GCFoundation packages are published on nuget.org and can be installed directly using the <code>dotnet</code> CLI or the Visual Studio Package Manager Console.</p>

        <hr />

        <gcds-heading tag="h2" id="package-installation">Package Installation</gcds-heading>
        <p>Install the following core NuGet packages (using the <code>dotnet</code> CLI):</p>
<pre><code class="language-powershell">dotnet add YourApp.Web package GCFoundation.Common
dotnet add YourApp.Web package GCFoundation.Components
dotnet add YourApp.Web package GCFoundation.Security</code></pre>

        <p>For navigation, breadcrumbs, and URL translation support, install:</p>
<pre><code class="language-powershell">dotnet add YourApp.Web package cloudscribe.Web.Navigation
dotnet add YourApp.Web package cloudscribe.Web.Localization
dotnet add YourApp.Web package cloudscribe.Web.SiteMap
dotnet add YourApp.Web package cloudscribe.Web.SiteMap.FromNavigation
dotnet add YourApp.Web package RouteLocalization.AspNetCore</code></pre>

        <p>If you prefer the Visual Studio Package Manager Console, you can use:</p>
<pre><code class="language-powershell">Install-Package GCFoundation.Common
Install-Package GCFoundation.Components
Install-Package GCFoundation.Security
Install-Package cloudscribe.Web.Navigation
Install-Package cloudscribe.Web.Localization
Install-Package cloudscribe.Web.SiteMap
Install-Package cloudscribe.Web.SiteMap.FromNavigation
Install-Package RouteLocalization.AspNetCore</code></pre>

        <hr />

        <gcds-heading tag="h2" id="basic-setup">Basic Setup</gcds-heading>
        <p>Add the following services in your <code>Program.cs</code>:</p>
<pre><code class="language-csharp">// MVC with localization support
builder.Services.AddControllersWithViews()
    .AddViewLocalization()
    .AddDataAnnotationsLocalization();

// Register GCFoundation services
builder.Services.AddGCFoundationComponents(builder.Configuration);
builder.Services.AddGCFoundationContentPolicies(builder.Configuration);
builder.Services.AddGCFoundationSession(builder.Configuration);
</code></pre>

        <hr />

        <gcds-heading tag="h2" id="components-setup">Components Setup</gcds-heading>
        <p>Enable GCFoundation components and session middleware in <code>Program.cs</code>:</p>
<pre><code class="language-csharp">// Load GCFoundation components and GCDS dependencies
app.UseGCFoundationComponents();
app.UseGCFoundationSession();
</code></pre>

        <hr />

        <gcds-heading tag="h2" id="security-setup">Security Setup</gcds-heading>
        <p>Add GCFoundation security policies and secure cookie configuration:</p>
<pre><code class="language-csharp">// Add GCFoundation Content Security Policy (CSP)
app.UseGCFoundationContentPolicies();

// Configure secure cookies
app.UseCookiePolicy(new CookiePolicyOptions
{
    MinimumSameSitePolicy = SameSiteMode.Strict,
    Secure = CookieSecurePolicy.Always,
    HttpOnly = HttpOnlyPolicy.Always
});
</code></pre>

        <hr />

        <gcds-heading tag="h2" id="language-setup">Language Setup</gcds-heading>
        <p>Configure localization, global resources, and culture selection in <code>Program.cs</code>:</p>
<pre><code class="language-csharp">// Configure global resources (resx)
builder.Services.Configure<GlobalResourceOptions>(builder.Configuration.GetSection("GlobalResourceOptions"));
builder.Services.AddSingleton<IStringLocalizerFactory, GlobalResourceManagerStringLocalizerFactory>();
builder.Services.AddLocalization();

// Configure supported cultures (e.g., en-CA, fr-CA)
var supportedCultures = LanguageUtility.GetSupportedCulture();
var routeSegmentLocalizationProvider = new FirstUrlSegmentRequestCultureProvider(supportedCultures.ToList());

builder.Services.Configure<RequestLocalizationOptions>(options =>
{
    options.DefaultRequestCulture = new RequestCulture(culture: "en-CA", uiCulture: "en-CA");
    options.SupportedCultures = supportedCultures;
    options.SupportedUICultures = supportedCultures;
    options.RequestCultureProviders.Insert(0, routeSegmentLocalizationProvider);
});

// Add route localization (translated URLs)
builder.Services.AddCustomRouteLocalization();
</code></pre>

        <p>Enable language and localization middleware:</p>
<pre><code class="language-csharp">// Add GCFoundation language middleware
app.UseMiddleware<GCFoundationLanguageMiddleware>();

// Enable ASP.NET Core request localization
var localizationOptions = app.Services.GetRequiredService&lt;IOptions&lt;RequestLocalizationOptions&gt;&gt;().Value;
app.UseRequestLocalization(localizationOptions);
</code></pre>

        <hr />

        <gcds-heading tag="h2" id="breadcrumbs-setup">Breadcrumbs Setup</gcds-heading>
        <p>Configure navigation and breadcrumbs services in <code>Program.cs</code>:</p>
<pre><code class="language-csharp">// Configure navigation services
builder.Services.AddScoped&lt;ISiteMapNodeService, NavigationTreeSiteMapNodeService&gt;();
builder.Services.AddCloudscribeNavigation(builder.Configuration.GetSection("NavigationOptions"));

// Configure breadcrumbs localization service
builder.Services.AddSingleton(typeof(IBreadcrumbsLocalizationService),
    typeof(BreadcrumbsLocalizationService&lt;YourApp.Resources.Navigation&gt;));
</code></pre>

        <hr />

        <gcds-heading tag="h2" id="menu-setup">Menu Setup <gcds-badge label="Optional" type="info"></gcds-badge></gcds-heading>
        <p>If you want the top navigation to display localized labels, register the top navigation localization service in <code>Program.cs</code>:</p>
<pre><code class="language-csharp">// Configure top navigation localization service
builder.Services.AddSingleton&lt;ITopNavigationLocalizationService,
    TopNavigationLocalizationService&lt;YourApp.Resources.Navigation&gt;&gt;();
</code></pre>

        <gcds-heading tag="h3" id="menu-component-visibility">Node Visibility</gcds-heading>
        <p>Each node in <code>navigation.xml</code> can declare which navigation surfaces it appears on using the <code>componentVisibility</code> attribute. Omitting it entirely means the node is shown in all surfaces by default.</p>
<pre><code class="language-xml">&lt;!-- Shown everywhere (topnav, breadcrumbs, sidenav) --&gt;
&lt;NavNode key="home" controller="Home" action="Index"
         text="Nav_Home" /&gt;

&lt;!-- Top nav only --&gt;
&lt;NavNode key="get-started" text="Nav_GetStarted"
         componentVisibility="topnav" /&gt;
</code></pre>

        <gcds-heading tag="h3" id="menu-restrictions">Customizable Visibility Restrictions <gcds-badge label="Optional" type="info"></gcds-badge></gcds-heading>
        <p>Navigation nodes can be conditionally shown or hidden based on cookies, session values, or claims. Define rules in <code>appsettings.json</code> using the nav node key as the rule key:</p>
<pre><code class="language-json">"NavigationRules": {
  "Rules": {
    "node-key1":  { "type": "Cookie",  "name": "TestCookie",  "value": "true" },
    "node-key2":  { "type": "Session", "name": "TestSession", "value": "true" },
    "node-key3": { "type": "Claim",   "name": "role",        "value": "admin" }
  }
}
</code></pre>
        <p>Then register the rules and the permission resolver in <code>Program.cs</code>:</p>
<pre><code class="language-csharp">// Bind navigation visibility rules from configuration
builder.Services.Configure&lt;NavRulesOptions&gt;(builder.Configuration.GetSection("NavigationRules"));

// Evaluate rules against the current request (cookie, session, or claim)
builder.Services.AddScoped&lt;INavigationNodePermissionResolver, ConfigurableNavPermissionResolver&gt;();
</code></pre>

        <hr />

        <gcds-heading tag="h2" id="url-translation">URL Translation</gcds-heading>
        <p>Configure routing with a culture parameter and translated URLs:</p>
<pre><code class="language-csharp">// Configure default route with culture parameter
app.MapControllerRoute(
    name: "default",
    pattern: "{culture=en}/{controller=Home}/{action=Index}/{id?}"
);
</code></pre>

        <p>Configure <code>appsettings.json</code> for navigation and global resources:</p>
<pre><code class="language-json">{
  "NavigationOptions": {
    "EnableLocalization": true,
    "LocalizationNamespace": "YourApp.Resources.Navigation"
  },
  "GlobalResourceOptions": {
    "ResourcePath": "Resources",
    "SupportedCultures": [ "en-CA", "fr-CA" ]
  }
}
</code></pre>

        <p>Key features:</p>
        <ul>
            <li>URL-based culture selection using the first segment (e.g., <code>/fr/home</code>)</li>
            <li>Default culture is <code>en-CA</code></li>
            <li>Automatic breadcrumb localization using resource files</li>
            <li>Support for culture-specific routing and translated routes using <code>RouteLocalization.AspNetCore</code></li>
        </ul>

        <hr />

        <gcds-heading tag="h2" id="complete-example">Complete Program.cs Example</gcds-heading>
        <p>Here's a complete <code>Program.cs</code> configuration that ties all of the above together for a typical MVC application:</p>
<pre><code class="language-csharp">using System.Globalization;
using cloudscribe.Web.Navigation;
using cloudscribe.Web.SiteMap;
using GCFoundation.Common.Utilities;
using GCFoundation.Components.Middleware;
using GCFoundation.Components.Services;
using GCFoundation.Components.Services.Interfaces;
using GCFoundation.Security.Middlewares;
using YourApp.Infrastructure.Extensions; // AddCustomRouteLocalization
using Microsoft.AspNetCore.CookiePolicy;
using Microsoft.AspNetCore.Localization;
using Microsoft.AspNetCore.Mvc.Razor;
using Microsoft.Extensions.Localization;
using Microsoft.Extensions.Options;

var builder = WebApplication.CreateBuilder(args);

// MVC and localization
builder.Services.AddControllersWithViews()
    .AddViewLocalization()
    .AddDataAnnotationsLocalization();

// Navigation and breadcrumbs
builder.Services.AddScoped&lt;ISiteMapNodeService, NavigationTreeSiteMapNodeService&gt;();
builder.Services.AddCloudscribeNavigation(builder.Configuration.GetSection("NavigationOptions"));
builder.Services.AddSingleton(typeof(IBreadcrumbsLocalizationService),
    typeof(BreadcrumbsLocalizationService&lt;YourApp.Resources.Navigation&gt;));

// Optional: localized top navigation labels
builder.Services.AddSingleton&lt;ITopNavigationLocalizationService,
    TopNavigationLocalizationService&lt;YourApp.Resources.Navigation&gt;&gt;();

// Global resources and localization
builder.Services.Configure&lt;GlobalResourceOptions&gt;(builder.Configuration.GetSection("GlobalResourceOptions"));
builder.Services.AddSingleton&lt;IStringLocalizerFactory, GlobalResourceManagerStringLocalizerFactory&gt;();
builder.Services.AddLocalization();

// GCFoundation services
builder.Services.AddGCFoundationComponents(builder.Configuration);
builder.Services.AddGCFoundationContentPolicies(builder.Configuration);
builder.Services.AddGCFoundationSession(builder.Configuration);

// Culture and URL-based localization
var supportedCultures = new[] { "en-CA", "fr-CA" }
    .Select(x => new CultureInfo(x))
    .ToList();

var routeSegmentLocalizationProvider = new FirstUrlSegmentRequestCultureProvider(supportedCultures);

builder.Services.Configure&lt;RequestLocalizationOptions&gt;(options =&gt;
{
    options.DefaultRequestCulture = new RequestCulture("en-CA");
    options.SupportedCultures = supportedCultures;
    options.SupportedUICultures = supportedCultures;
    options.RequestCultureProviders.Insert(0, routeSegmentLocalizationProvider);
});

// Add route localization extensions (translated routes)
builder.Services.AddCustomRouteLocalization();

var app = builder.Build();

// Error handling (production)
if (!app.Environment.IsDevelopment())
{
    app.UseExceptionHandler("/Error");
    app.UseHsts();
}

// GCFoundation language middleware
app.UseMiddleware&lt;GCFoundationLanguageMiddleware&gt;();

// Security and static files
app.UseHttpsRedirection();
app.UseStaticFiles();

app.UseRouting();

// Request localization
var localizationOptions = app.Services.GetRequiredService&lt;IOptions&lt;RequestLocalizationOptions&gt;&gt;().Value;
app.UseRequestLocalization(localizationOptions);

// Secure cookies
app.UseCookiePolicy(new CookiePolicyOptions
{
    MinimumSameSitePolicy = SameSiteMode.Strict,
    Secure = CookieSecurePolicy.Always,
    HttpOnly = HttpOnlyPolicy.Always
});

// GCFoundation components and security
app.UseGCFoundationComponents();
app.UseGCFoundationContentPolicies();
app.UseGCFoundationSession();

// Authorization and routing
app.UseAuthorization();

app.MapControllerRoute(
    name: "default",
    pattern: "{culture=en}/{controller=Home}/{action=Index}/{id?}");

app.Run();
</code></pre>

        <p>Required <code>appsettings.json</code> configuration:</p>
<pre><code class="language-json">{
  "NavigationOptions": {
    "EnableLocalization": true,
    "LocalizationNamespace": "YourApp.Resources.Navigation"
  },
  "GlobalResourceOptions": {
    "ResourcePath": "Resources",
    "SupportedCultures": [ "en-CA", "fr-CA" ]
  }
}
</code></pre>

        <p>Example project structure for navigation resources:</p>
<pre><code>YourApp/
  └── Resources/
      ├── Navigation.en-CA.resx
      ├── Navigation.fr-CA.resx
      └── Navigation/   (optional additional navigation resources)
</code></pre>

{
  "name": "gcfoundation-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "End-to-end tests for GCFoundation.Web using Playwright (Chrome + Edge)",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ci": "playwright test",
    "test:a11y": "playwright test -g @a11y",
    "test:a11y:ci": "playwright test -g @a11y --output test-artifacts-a11y",
    "test:i18n": "playwright test -g @i18n",
    "test:i18n:warn": "cross-env I18N_WARN_ONLY=1 playwright test -g @i18n",
    "test:smoke": "playwright test -g @smoke",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "@axe-core/playwright": "^4.9.0",
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.16.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.0"
  }
}



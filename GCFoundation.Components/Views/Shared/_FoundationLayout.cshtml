@using cloudscribe.Web.Navigation
@using GCFoundation.Common.Models
@using GCFoundation.Common.Settings
@using GCFoundation.Common.Utilities
@using GCFoundation.Components.Enums
@using GCFoundation.Components.Helpers
@using GCFoundation.Components.Models
@using GCFoundation.Components.Settings
@using Microsoft.AspNetCore.Routing
@using Microsoft.Extensions.Options

@inject IOptions<GCFoundationComponentsSettings> settings;
@inject IOptions<GCFoundationSessionSetting> sessionSetting;

<!DOCTYPE html>
<html lang="@LanguageUtility.GetCurrentApplicationLanguage()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    @* Meta tags (merge Global meta tags and custom meta tags defined in the GCFoundationBaseController) *@
    @{
        var globalMetaTags = settings.Value.GlobalMetaTags;
        var controllerMetaTags = ViewData["MetaTags"] as IEnumerable<MetaTag>;
        var metaTags = new List<MetaTag>();
        if (controllerMetaTags != null && controllerMetaTags.Any())
        {
            metaTags.AddRange(controllerMetaTags);
        }
        if (globalMetaTags != null && globalMetaTags.Any())
        {
            // Add any Global meta tag that does not (already) exist in the list of custom meta tags.
            metaTags.AddRange(globalMetaTags.Where(gmt => !metaTags.Any(mt => (!string.IsNullOrEmpty(gmt.Name) && mt.Name == gmt.Name) || (!string.IsNullOrEmpty(gmt.Property) && mt.Property == gmt.Property))).ToList());
        }
        foreach (var tag in metaTags)
        {
            @Html.Raw(tag.Render());
        }
    }
    @await RenderSectionAsync("Metas", required: false)
    
    <title>@ViewData["Title"] - @settings.Value.ApplicationName</title>
    
    @* Adobe Analytics (if enabled) *@
    @if (settings.Value.IncludeAdobeAnalytics)
    {
        <script src="@settings.Value.AdobeAnalyticsCdnJsUrl"></script>
    }

    @* Global link tags from configuration *@
    @foreach (var linkTag in settings.Value.GlobalLinkTags)
    {
        @Html.Raw(linkTag)
    }
    
    <link href="@StaticResourceHelper.GetImageResourcePath("favicon.ico")" rel="icon" type="image/x-icon">
    
    @* GCDS CSS from CDN (if enabled) *@
    @if (settings.Value.IncludeGCDSResources)
    {
        <link rel="stylesheet" href="@settings.Value.GCDSCssCDN" />
    }
    
    @* Font Awesome CSS from CDN (if enabled) *@
    @if (settings.Value.IncludeFontAwesome)
    {
        <link rel="stylesheet" href="@settings.Value.FontAwesomeCDN" />
    }
    
    @* Default foundation CSS files (always included) *@
    <link rel="stylesheet" href="@StaticResourceHelper.GetLibResourcePath("prism/css/prism.css")" asp-append-version="true" />
    @* Grid.js CSS (if enabled) *@
    @if (settings.Value.IncludeGridJs)
    {
        if (settings.Value.UseGridJsCdn)
        {
            <link rel="stylesheet" href="@settings.Value.GridJsCdnCssUrl" />
        }
        else
        {
            <link rel="stylesheet" href="@StaticResourceHelper.GetLibResourcePath("gridjs/theme/mermaid.min.css")" asp-append-version="true" />
        }
    }
    <link rel="stylesheet" href="@StaticResourceHelper.GetLibResourcePath("quill/quill.snow.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@StaticResourceHelper.GetCssResourcePath("foundation.min.css")" asp-append-version="true" />
    
    @* Global CSS files from configuration *@
    @foreach (var cssFile in settings.Value.GlobalCssFiles)
    {
        if (cssFile.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            <link rel="stylesheet" href="@cssFile" />
        }
        else
        {
            <link rel="stylesheet" href="@Url.Content(cssFile)" asp-append-version="true" />
        }
    }
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        RouteValueDictionary routeValueDictionary = new RouteValueDictionary(ViewContext.RouteData.Values);
        routeValueDictionary["culture"] = LanguageUtility.GetOppositeLangauge();
            Language currentLanguage = Language.en;

        if (LanguageUtility.GetCurrentApplicationLanguage() == "fr")
        {
            currentLanguage = Language.fr;
        }
    }
    <gcds-header lang-href="@Url.RouteUrl(routeValueDictionary)" skip-to-href="#main-content" lang="@currentLanguage">
        @{
            string? bannerPartialViewName = ViewData["BannerPartialViewName"] as string;
            string? breadcrumbsPartialViewName = ViewData["BreadcrumbsPartialViewName"] as string;
            string? menuPartialViewName = ViewData["MenuPartialViewName"] as string;
            string? searchPartialViewName = ViewData["SearchPartialViewName"] as string;
            
        }

        @* Load a banner view if defined *@
        @if (!string.IsNullOrEmpty(bannerPartialViewName))
        {
            <div slot="banner">
                @await Html.PartialAsync(bannerPartialViewName)
            </div>
        }

        @* Load a menu view if defined *@
        @if (!string.IsNullOrEmpty(menuPartialViewName))
        {
            <div slot="menu">
                @await Html.PartialAsync(menuPartialViewName)
            </div>
        }

        @* Load a search view if defined *@
        @if (!string.IsNullOrEmpty(searchPartialViewName))
        {
            <div slot="search">
                @await Html.PartialAsync(searchPartialViewName)
            </div>
        }

        @* Load a breadcrumbs view if defined; otherwise, use default *@
        @if (!string.IsNullOrEmpty(breadcrumbsPartialViewName))
        {
            @await Html.PartialAsync(breadcrumbsPartialViewName)
        }
        else
        {
            @await Component.InvokeAsync("Navigation", new { viewName = "GCDSBreadcrumbs", filterName = NamedNavigationFilters.Breadcrumbs, startingNodeKey = "" })
        }
    </gcds-header>
    <gcds-container id="main-content" size="xl" centered tag="main" main-container class="mb-300">
        @{
            string? LoginPartialViewName = ViewData["LoginPartialViewName"] as string;
        }

        @if(!string.IsNullOrEmpty(LoginPartialViewName))
        {
            @await Html.PartialAsync(LoginPartialViewName)
        }

        <partial name="_PageNotification" />
        @* Main content *@
        @RenderBody()
        
        @* Date modified or Version Identifier *@
        @{
            var dateModified = ViewData["DateModified"] as string;
            var applicationVersion = settings.Value.ApplicationVersion;
            var dmType = (!string.IsNullOrEmpty(dateModified) ? DateModifiedType.date : DateModifiedType.version);
            var dmContent = (!string.IsNullOrEmpty(dateModified) ? dateModified : applicationVersion);
        }
        @if (!string.IsNullOrEmpty(dmContent))
        {
            <gcds-date-modified type="@dmType">@dmContent</gcds-date-modified>
        }
    </gcds-container>

    @* GC Footer *@
    @{
        var footerContextualHeading = ViewData["FooterContextualHeading"] as string;
        var footerContextualLinks = ViewData["FooterContextualLinks"] as IEnumerable<FooterLink>;
        var footerSubLinks = ViewData["FooterSubLinks"] as IEnumerable<FooterLink>;
    }
    <gcds-footer display="full" contextual-heading="@footerContextualHeading" contextual-links="@footerContextualLinks" sub-links="@footerSubLinks"></gcds-footer>

    @* Render all modal in that section to make sure to block all content on the page *@
    @await RenderSectionAsync("Modals", required: false)

    @* If the session management is activated  *@
    @if (sessionSetting.Value.UseSession && sessionSetting.Value.UseReminder)
    {
        @await Html.PartialAsync("Modals/_ExtendSessionModal");
    }

    @* GCDS JavaScript from CDN (if enabled) *@
    @if (settings.Value.IncludeGCDSResources)
    {
        <script type="module" src="@settings.Value.GCDSJavaScriptCDN"></script>
    }

    @* Default foundation JavaScript files (always included) *@
    <script src="@StaticResourceHelper.GetLibResourcePath("prism/js/prism.js")" asp-append-version="true"></script>
    @* Grid.js JS (if enabled) - load BEFORE foundation so our wrappers can detect it *@
    @if (settings.Value.IncludeGridJs)
    {
        if (settings.Value.UseGridJsCdn)
        {
            <script src="@settings.Value.GridJsCdnJsUrl"></script>
        }
        else
        {
            <script src="@StaticResourceHelper.GetLibResourcePath("gridjs/gridjs.production.min.js")" asp-append-version="true"></script>
        }
    }
    <script src="@StaticResourceHelper.GetLibResourcePath("quill/quill.js")" asp-append-version="true"></script>
    <script src="@StaticResourceHelper.GetJsResourcePath("foundation.min.js")" asp-append-version="true"></script>

    @* Global JavaScript files from configuration *@
    @foreach (var jsFile in settings.Value.GlobalJavaScriptFiles)
    {
        if (jsFile.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            <script src="@jsFile"></script>
        }
        else
        {
            <script src="@Url.Content(jsFile)" asp-append-version="true"></script>
        }
    }
    
    @* Adobe Analytics (if enabled) *@
    @if (settings.Value.IncludeAdobeAnalytics)
    {
        <script type="text/javascript" nonce="@(Context.Items["CspNonce"])">if (typeof _satellite == "object") { _satellite.pageBottom(); } else { console.log("Adobe DTM/Launch has not been loaded yet."); }</script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
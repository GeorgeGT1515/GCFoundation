@using GCFoundation.Common.Utilities
@using GCFoundation.Components.Enums
@using GCFoundation.Components.Helpers
@using GCFoundation.Components.Resources
@{
	Layout = "_BilingualErrorTemplate";
	ViewData["Title"] = @Error.Global_Title;
	string lang = LanguageUtility.GetCurrentApplicationLanguage();
}
<gcds-heading tag="h1">@Error.Global_Title</gcds-heading>
<gcds-notice type="@AlertType.Danger" title="@Error.Global_Notice_Title" title-tag="h2">
	@Html.Raw(Error.Global_Notice_Content)
</gcds-notice>